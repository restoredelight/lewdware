{
  "$schema": "../../docs/src/data/config.schema.json",
  // "$schema": "https://lewdware.github.com/mode.schema.json",
  "include": ["../shared", "src"],
  "id": "cd5a36d6-ca1c-4381-97b3-0d2f00d1d401",
  "name": "Sandbox",
  "version": "0.1.0",
  "author": "restoredelight",
  "entrypoint": "src/main.lua",
  "options": {
    "popup_frequency": {
      "label": "Popup frequency (seconds)",
      "description": "How often popups appear",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 60,
      "step": 0.1,
      "show_when": { "spawn_mode": "constant" }
    },
    "max_popups": {
      "label": "Maximum simultaneous popups",
      "type": "integer",
      "optional": true,
      "default": 5,
      "min": 1
    },
    "media_types": {
      "type": "group",
      "label": "Media types",
      "options": {
        "images_enabled": {
          "label": "Images",
          "type": "boolean",
          "default": true
        },
        "videos_enabled": {
          "label": "Videos",
          "type": "boolean",
          "default": true
        },
        "audio_enabled": {
          "label": "Audio",
          "type": "boolean",
          "default": true
        }
      }
    },
    "spawn_pattern": {
      "type": "group",
      "label": "Spawn pattern",
      "options": {
        "spawn_mode": {
          "label": "Spawn mode",
          "type": "enum",
          "default": "constant",
          "values": {
            "constant": "Constant",
            "accelerating": "Accelerating",
            "random": "Random interval"
          }
        },
        "start_frequency": {
          "label": "Starting frequency (seconds)",
          "description": "Initial time between popups; shrinks each spawn",
          "type": "number",
          "default": 5,
          "min": 0.1,
          "step": 0.1,
          "show_when": { "spawn_mode": "accelerating" }
        },
        "acceleration_factor": {
          "label": "Acceleration factor",
          "description": "Interval is multiplied by this after each popup — values below 1 get faster over time",
          "type": "number",
          "default": 0.9,
          "min": 0.01,
          "max": 0.99,
          "step": 0.01,
          "show_when": { "spawn_mode": "accelerating" }
        },
        "min_frequency": {
          "label": "Minimum frequency (seconds)",
          "description": "Fastest rate the mode will reach",
          "type": "number",
          "default": 0.25,
          "min": 0.05,
          "step": 0.05,
          "show_when": { "spawn_mode": "accelerating" }
        },
        "random_min": {
          "label": "Minimum interval (seconds)",
          "type": "number",
          "default": 0.5,
          "min": 0.05,
          "step": 0.05,
          "show_when": { "spawn_mode": "random" }
        },
        "random_max": {
          "label": "Maximum interval (seconds)",
          "type": "number",
          "default": 5,
          "min": 0.1,
          "step": 0.1,
          "show_when": { "spawn_mode": "random" }
        }
      }
    },
    "dormancy": {
      "type": "group",
      "label": "Dormancy cycles",
      "options": {
        "dormancy_enabled": {
          "label": "Enable dormancy cycles",
          "description": "Alternates between active and dormant periods",
          "type": "boolean",
          "default": false
        },
        "active_min": {
          "label": "Active duration minimum (seconds)",
          "type": "number",
          "default": 30,
          "min": 1,
          "show_when": { "dormancy_enabled": true }
        },
        "active_max": {
          "label": "Active duration maximum (seconds)",
          "type": "number",
          "default": 120,
          "min": 1,
          "show_when": { "dormancy_enabled": true }
        },
        "dormant_min": {
          "label": "Dormant duration minimum (seconds)",
          "type": "number",
          "default": 120,
          "min": 1,
          "show_when": { "dormancy_enabled": true }
        },
        "dormant_max": {
          "label": "Dormant duration maximum (seconds)",
          "type": "number",
          "default": 600,
          "min": 1,
          "show_when": { "dormancy_enabled": true }
        }
      }
    },
    "close_trigger": {
      "type": "group",
      "label": "Close trigger",
      "options": {
        "close_trigger_enabled": {
          "label": "Spawn popups when closing",
          "description": "Closing a popup may spawn more",
          "type": "boolean",
          "default": false
        },
        "close_chance": {
          "label": "Spawn chance (0–1)",
          "description": "Probability that closing a popup triggers more spawns",
          "type": "number",
          "default": 0.5,
          "min": 0.01,
          "max": 1,
          "step": 0.01,
          "show_when": { "close_trigger_enabled": true }
        },
        "close_count": {
          "label": "Spawns per trigger",
          "type": "integer",
          "default": 2,
          "min": 1,
          "max": 10,
          "show_when": { "close_trigger_enabled": true }
        }
      }
    },
    "movement": {
      "type": "group",
      "label": "Movement",
      "options": {
        "movement_enabled": {
          "label": "Move windows after spawning",
          "type": "boolean",
          "default": false
        },
        "movement_speed_min": {
          "label": "Minimum speed (px/s)",
          "type": "number",
          "default": 50,
          "min": 10,
          "step": 10,
          "show_when": { "movement_enabled": true }
        },
        "movement_speed_max": {
          "label": "Maximum speed (px/s)",
          "type": "number",
          "default": 150,
          "min": 10,
          "step": 10,
          "show_when": { "movement_enabled": true }
        }
      }
    },
    "captions": {
      "type": "group",
      "label": "Captions",
      "show_when": { "pack_has_captions": true },
      "options": {
        "captions_enabled": {
          "label": "Show captions on popups",
          "type": "boolean",
          "default": true
        }
      }
    },
    "notifications": {
      "type": "group",
      "label": "Notifications",
      "show_when": { "pack_has_notifications": true },
      "options": {
        "notifications_enabled": {
          "label": "Show notifications",
          "type": "boolean",
          "default": true,
          "needs_permissions": ["send_notifications"]
        },
        "notification_frequency": {
          "label": "Notification frequency (seconds)",
          "description": "How often a notification appears",
          "type": "number",
          "default": 120,
          "min": 1,
          "step": 1,
          "show_when": { "notifications_enabled": true }
        }
      }
    },
    "web_opening": {
      "type": "group",
      "label": "Web opening",
      "show_when": { "pack_has_web_links": true },
      "needs_permissions": ["open_links"],
      "options": {
        "web_opening_enabled": {
          "label": "Open web links",
          "type": "boolean",
          "default": true,
          "needs_permissions": ["open_links"]
        },
        "web_frequency": {
          "label": "Web link frequency (seconds)",
          "description": "How often a web link opens",
          "type": "number",
          "default": 300,
          "min": 1,
          "step": 1,
          "show_when": { "web_opening_enabled": true }
        }
      }
    },
    "subliminals": {
      "type": "group",
      "label": "Subliminals",
      "show_when": { "pack_has_subliminals": true },
      "options": {
        "subliminals_enabled": {
          "label": "Show subliminal flashes",
          "type": "boolean",
          "default": true
        },
        "subliminal_frequency": {
          "label": "Subliminal frequency (seconds)",
          "type": "number",
          "default": 20,
          "min": 1,
          "step": 1,
          "show_when": { "subliminals_enabled": true }
        },
        "subliminal_opacity": {
          "label": "Subliminal opacity",
          "type": "number",
          "default": 0.5,
          "min": 0.05,
          "max": 1,
          "step": 0.05,
          "slider": true,
          "show_when": { "subliminals_enabled": true }
        }
      }
    },
    "prompts": {
      "type": "group",
      "label": "Prompts",
      "show_when": { "pack_has_prompts": true },
      "options": {
        "prompts_enabled": {
          "label": "Show prompts",
          "description": "Dialogs that stay up until you type the pack's text back exactly",
          "type": "boolean",
          "default": true
        },
        "prompt_frequency": {
          "label": "Prompt frequency (seconds)",
          "type": "number",
          "default": 90,
          "min": 1,
          "step": 1,
          "show_when": { "prompts_enabled": true }
        }
      }
    },
    "wallpaper_and_splash": {
      "type": "group",
      "label": "Wallpaper & splash",
      "options": {
        "wallpaper_enabled": {
          "label": "Change wallpaper",
          "type": "boolean",
          "default": true,
          "needs_permissions": ["set_wallpaper"],
          "show_when": { "pack_has_wallpaper": true }
        },
        "splash_enabled": {
          "label": "Show a splash image at start",
          "type": "boolean",
          "default": true,
          "show_when": { "pack_has_splash": true }
        }
      }
    }
  }
}
