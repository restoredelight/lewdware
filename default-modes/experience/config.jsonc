{
  "$schema": "../../docs/src/data/config.schema.json",
  // "$schema": "https://lewdware.github.com/mode.schema.json",
  "include": ["../shared", "src"],
  "id": "db090a6a-51af-42cb-9af9-639f554f48a2",
  "name": "Sequence",
  "version": "0.1.0",
  "author": "restoredelight",
  "entrypoint": "src/main.lua",
  "options": {
    "theme": {
      "label": "Window style",
      "description": "How popup frames, buttons and text fields look. \"As designed by the pack\" uses the pack author's choice, falling back to your system's look if they didn't make one",
      "type": "enum",
      "default": "auto",
      "values": {
        "auto": "As designed by the pack, or match my system",
        "native": "Match my system",
        "native-retro": "Match my system (retro)",
        "plain": "Plain",
        "fluent": "Windows 11",
        "redmond": "Windows 95",
        "aqua": "macOS",
        "adwaita": "GNOME",
        "platinum": "Mac OS 9"
      }
    },
    "appearance": {
      "label": "Light or dark",
      "description": "Which palette the window style is drawn in. Some styles have no dark version and stay light",
      "type": "enum",
      "default": "auto",
      "values": {
        "auto": "Match my system",
        "light": "Light",
        "dark": "Dark"
      }
    },
    "pace": {
      "label": "Pacing",
      "description": "Scales the pack author's designed spawn/notification/web/prompt/subliminal rates -- 1.0 is the design as authored, higher is faster",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 5,
      "step": 0.1,
      "slider": true
    },
    "max_popups": {
      "label": "Maximum simultaneous popups",
      "type": "integer",
      "optional": true,
      "default": 5,
      "min": 1
    },
    "media_types": {
      "type": "group",
      "label": "Media types",
      "options": {
        "images_enabled": {
          "label": "Images",
          "type": "boolean",
          "default": true
        },
        "videos_enabled": {
          "label": "Videos",
          "type": "boolean",
          "default": true
        },
        "audio_enabled": {
          "label": "Audio",
          "type": "boolean",
          "default": true
        }
      }
    },
    "close_trigger": {
      "type": "group",
      "label": "Close trigger",
      "options": {
        "close_trigger_enabled": {
          "label": "Spawn popups when closing",
          "description": "Closing a popup may spawn more -- chance and count are the pack author's design",
          "type": "boolean",
          "default": false
        }
      }
    },
    "movement": {
      "type": "group",
      "label": "Movement",
      "options": {
        "movement_enabled": {
          "label": "Move windows after spawning",
          "description": "Speed is the pack author's design",
          "type": "boolean",
          "default": false
        }
      }
    },
    "captions": {
      "type": "group",
      "label": "Captions",
      "show_when": { "pack_has_captions": true },
      "options": {
        "captions_enabled": {
          "label": "Show captions on popups",
          "type": "boolean",
          "default": true
        }
      }
    },
    "notifications": {
      "type": "group",
      "label": "Notifications",
      "show_when": { "pack_has_notifications": true },
      "options": {
        "notifications_enabled": {
          "label": "Show notifications",
          "type": "boolean",
          "default": true,
          "needs_permissions": ["send_notifications"]
        }
      }
    },
    "web_opening": {
      "type": "group",
      "label": "Web opening",
      "show_when": { "pack_has_web_links": true },
      "options": {
        "web_opening_enabled": {
          "label": "Open web links",
          "type": "boolean",
          "default": true,
          "needs_permissions": ["open_links"]
        }
      }
    },
    "subliminals": {
      "type": "group",
      "label": "Subliminals",
      "show_when": { "pack_has_subliminals": true },
      "options": {
        "subliminals_enabled": {
          "label": "Show subliminal flashes",
          "type": "boolean",
          "default": true
        },
        "subliminal_opacity": {
          "label": "Subliminal opacity",
          "type": "number",
          "default": 0.5,
          "min": 0.05,
          "max": 1,
          "step": 0.05,
          "slider": true,
          "show_when": { "subliminals_enabled": true }
        }
      }
    },
    "prompts": {
      "type": "group",
      "label": "Prompts",
      "show_when": { "pack_has_prompts": true },
      "options": {
        "prompts_enabled": {
          "label": "Show prompts",
          "type": "boolean",
          "default": true
        }
      }
    },
    "wallpaper_and_splash": {
      "type": "group",
      "label": "Wallpaper & splash",
      "options": {
        "wallpaper_enabled": {
          "label": "Change wallpaper",
          "type": "boolean",
          "default": true,
          "needs_permissions": ["set_wallpaper"],
          "show_when": { "pack_has_wallpaper": true }
        },
        "splash_enabled": {
          "label": "Show a splash image at start",
          "type": "boolean",
          "default": true,
          "show_when": { "pack_has_splash": true }
        }
      }
    }
  }
}
