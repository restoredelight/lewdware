#!/bin/sh
if [ -e "$HOME/wallpaper-fail-restore" ]; then
 for arg in "$@"; do
  if [ "$arg" = --set ] || [ "$arg" = -s ]; then
   echo 'vmctl injected xfconf write failure' >&2
   exit 77
  fi
 done
fi
if [ -e "$HOME/wallpaper-fail-read" ]; then
 case " $* " in
  *' --set '*|*' -s '*) ;;
  *) echo 'vmctl injected xfconf read failure' >&2; exit 78;;
 esac
fi
exec /usr/bin/xfconf-query "$@"
