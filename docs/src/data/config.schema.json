{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lewdware.github.com/config.schema.json",
  "title": "Mode Config",
  "description": "Configuration file for a mode",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable identity for this mode, used to scope lewdware.storage across restarts and rebuilds. Generated once by `lw mode new` -- never edit this by hand."
    },
    "name": {
      "description": "The name of the mode",
      "type": "string"
    },
    "description": {
      "description": "A short explanation of what the mode does, shown when users choose a mode",
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoint": {
      "type": "string",
      "description": "The path to the main lua file for the mode"
    },
    "needs_permissions": {
      "$ref": "#/$defs/needs_permissions"
    },
    "options": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": ["id", "name", "entrypoint"],

  "$defs": {
    "condition_value": {
      "description": "A primitive value used in a show_when condition",
      "oneOf": [
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" }
      ]
    },

    "show_when": {
      "description": "Map of option keys to required values. All conditions must match for this entry to be visible. null values never satisfy any condition.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/condition_value"
      }
    },

    "needs_permissions": {
      "type": "array",
      "description": "Permissions this entry uses. Declaring one grants nothing -- the user owns these, and a denied permission simply makes the corresponding call do nothing. It lets the Lewdware config app say \"this won't do anything until you allow X\" next to the option itself, and offer to turn it on there.",
      "items": {
        "enum": ["set_wallpaper", "open_links", "send_notifications"]
      },
      "uniqueItems": true
    },

    "entry": {
      "oneOf": [
        { "$ref": "#/$defs/option" },
        { "$ref": "#/$defs/group" }
      ]
    },

    "group": {
      "type": "object",
      "description": "A collapsible group of options",
      "properties": {
        "type": { "const": "group" },
        "label": {
          "type": "string",
          "description": "The heading shown to the user"
        },
        "description": {
          "type": "string"
        },
        "show_when": {
          "$ref": "#/$defs/show_when"
        },
        "needs_permissions": {
          "$ref": "#/$defs/needs_permissions"
        },
        "options": {
          "type": "object",
          "description": "The options inside this group",
          "additionalProperties": {
            "$ref": "#/$defs/option"
          }
        }
      },
      "required": ["type", "label", "options"],
      "unevaluatedProperties": false
    },

    "option": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "The label shown to the user"
        },
        "description": {
          "type": "string",
          "description": "An optional description shown below the label"
        },
        "optional": {
          "type": "boolean",
          "description": "If true, the value may be null/disabled. Use \"enabled_by_default\" to control the initial state."
        },
        "enabled_by_default": {
          "type": "boolean",
          "description": "For optional options: whether the option starts enabled. Defaults to false."
        },
        "show_when": {
          "$ref": "#/$defs/show_when"
        },
        "needs_permissions": {
          "$ref": "#/$defs/needs_permissions"
        },
        "type": {
          "enum": ["integer", "number", "string", "boolean", "enum"]
        }
      },
      "required": ["label", "type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "integer" },
            "default": { "type": "integer" },
            "min": { "type": "integer" },
            "max": { "type": "integer" },
            "step": { "type": "integer" },
            "clamp": { "type": "boolean" },
            "slider": { "type": "boolean" }
          },
          "required": ["default"]
        },
        {
          "properties": {
            "type": { "const": "number" },
            "default": { "type": "number" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number" },
            "clamp": { "type": "boolean" },
            "slider": { "type": "boolean" }
          },
          "required": ["default"]
        },
        {
          "properties": {
            "type": { "const": "string" },
            "default": { "type": "string" }
          },
          "required": ["default"]
        },
        {
          "properties": {
            "type": { "const": "boolean" },
            "default": { "type": "boolean" }
          },
          "required": ["default"]
        },
        {
          "properties": {
            "type": { "const": "enum" },
            "values": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": "The label shown to the user"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "description": "The label shown to the user"
                      },
                      "description": {
                        "type": "string",
                        "description": "A line explaining what choosing this does, shown under the label when the choice is open. Put the explanation here rather than growing the label into a sentence."
                      }
                    },
                    "required": ["label"],
                    "additionalProperties": false
                  }
                ]
              },
              "minProperties": 1
            },
            "default": { "type": "string" }
          },
          "required": ["values", "default"]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
