---
source: converter/tests/golden.rs
expression: output
---
metadata:
  name: Corruption Fixture Pack
  creator: Test Author
  description: A small synthetic pack for converter golden tests (corruption.json + config.json -> experience).
  version: "1.0"
  recommended_mode: Experience
behaviour:
  version: 3
  content:
    content_groups:
      - id: vanilla
        label: vanilla
        tags:
          - vanilla
        enabled_by_default: true
      - id: kinky
        label: kinky
        tags:
          - kinky
        enabled_by_default: true
      - id: corrupted
        label: corrupted
        tags:
          - corrupted
        enabled_by_default: true
    captions:
      - text: Default caption
        tags: []
      - text: Vanilla caption
        tags:
          - vanilla
      - text: Kinky caption
        tags:
          - kinky
      - text: Corrupted caption
        tags:
          - corrupted
    prompts: []
    prompt_settings:
      submit_label: ~
    notifications: []
    subliminals: []
    web_links: []
    wallpaper: wallpaper.png
  experience:
    timeline:
      stages:
        - id: stage-1
          label: Stage 1
          end:
            duration_seconds: 120
            event_count:
              event: popup
              count: 8
              scope: session
            strategy: any
          content:
            tags:
              - corruption-moodless
              - vanilla
            wallpaper: wallpaper.png
          events:
            popup:
              interval:
                kind: fixed
                seconds: 2
        - id: stage-2
          label: Stage 2
          end:
            duration_seconds: 120
            event_count:
              event: popup
              count: 16
              scope: session
            strategy: any
          content:
            tags:
              - corruption-moodless
              - kinky
              - vanilla
          events:
            popup:
              interval:
                kind: fixed
                seconds: 2
            prompt:
              interval:
                kind: fixed
                seconds: 20
        - id: stage-3
          label: Stage 3
          content:
            tags:
              - corrupted
              - corruption-moodless
              - kinky
            wallpaper: wallpaper2.png
          events:
            popup:
              interval:
                kind: fixed
                seconds: 2
            prompt:
              interval:
                kind: fixed
                seconds: 20
      transitions:
        - id: transition-1
          from_stage: stage-1
          to_stage: stage-2
          duration_seconds: 0
          easing: linear
          affected: []
        - id: transition-2
          from_stage: stage-2
          to_stage: stage-3
          duration_seconds: 0
          easing: linear
          affected: []
    label: Corruption
media:
  - source_path: wallpaper.png
    suggested_name: wallpaper.png
    tags:
      - __lewdware-non-popup
  - source_path: wallpaper2.png
    suggested_name: wallpaper2.png
    tags:
      - __lewdware-non-popup
  - source_path: img/kinky_a.png
    suggested_name: kinky_a.png
    tags:
      - kinky
  - source_path: img/untagged.png
    suggested_name: untagged.png
    tags:
      - corruption-moodless
  - source_path: img/vanilla_a.png
    suggested_name: vanilla_a.png
    tags:
      - vanilla
icon: ~
warnings:
  - kind: ConfigNotConverted
    message: "config.json's other setting(s) (corruptionMode) have no Lewdware equivalent and were dropped"
